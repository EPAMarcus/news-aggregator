        <!-- Rollup chain -->
        <mxCell id="chain" value="Rollup chain (each level is built from the level below)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=12;fillColor=#ffffff;strokeColor=#666666;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="720" width="620" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="Daily&lt;br&gt;new items" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
