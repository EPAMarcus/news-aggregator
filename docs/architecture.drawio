        <mxCell id="c2" value="Weekly&lt;br&gt;Mon–Sun dailies" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="475" y="760" width="120" height="55" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="Monthly&lt;br&gt;full weeklies +&lt;br&gt;edge-day dailies" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="635" y="760" width="120" height="55" as="geometry" />
