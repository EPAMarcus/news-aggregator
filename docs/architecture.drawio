<mxfile host="app.diagrams.net" agent="Claude Code" version="24.0.0">
  <diagram id="news-aggregator-architecture" name="Architecture">
    <mxGraphModel dx="1200" dy="860" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="860" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title and notes -->
        <mxCell id="title" value="&lt;b&gt;News Aggregator&lt;/b&gt;&lt;br&gt;Architecture overview" style="text;html=1;align=left;verticalAlign=top;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="note" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;All times Europe/Berlin.&lt;br&gt;Cron runs in UTC, so each run has a local-time guard.&lt;br&gt;Runs are idempotent: an existing digest file means skip." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fillColor=#fffbe6;strokeColor=#d6b656;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="480" width="200" height="110" as="geometry" />
        </mxCell>

        <!-- Sources -->
        <mxCell id="srcBox" value="Sources (config/sources.yaml, optional topic tag each)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=12;fillColor=#fffbe6;strokeColor=#d6b656;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="200" height="250" as="geometry" />
        </mxCell>
        <mxCell id="rss" value="RSS / Atom feeds&lt;br&gt;(blogs, news sites)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="255" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="web" value="Web pages&lt;br&gt;(best-effort scraping)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="320" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="mail" value="Newsletters&lt;br&gt;(Gmail inbox via IMAP)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="385" width="160" height="50" as="geometry" />
        </mxCell>

        <!-- Scheduler -->
        <mxCell id="sched" value="GitHub Actions (private repo, cron + workflow_dispatch)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=12;fillColor=#f5f9ff;strokeColor=#6c8ebf;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="40" width="620" height="110" as="geometry" />
        </mxCell>
        <mxCell id="wf1" value="daily.yml&lt;br&gt;every day 06:00" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="310" y="85" width="135" height="50" as="geometry" />
        </mxCell>
        <mxCell id="wf2" value="weekly.yml&lt;br&gt;Sunday 17:00" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="460" y="85" width="135" height="50" as="geometry" />
        </mxCell>
        <mxCell id="wf3" value="monthly.yml&lt;br&gt;last day 20:00" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="610" y="85" width="135" height="50" as="geometry" />
        </mxCell>
        <mxCell id="wf4" value="yearly job&lt;br&gt;31.12., needs: monthly" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="760" y="85" width="145" height="50" as="geometry" />
        </mxCell>
        <mxCell id="eChain" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#6c8ebf;dashed=1;" edge="1" parent="1" source="wf3" target="wf4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Pipeline -->
        <mxCell id="pipe" value="python -m aggregator run --level &amp;lt;daily|weekly|monthly|yearly&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=12;fillColor=#f4faf3;strokeColor=#82b366;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="200" width="620" height="250" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="1. Guard&lt;br&gt;local-time window,&lt;br&gt;output exists?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="320" y="240" width="130" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="2. Collect inputs&lt;br&gt;daily: fetch + dedupe&lt;br&gt;others: read lower digests" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="470" y="240" width="150" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="3. Summarize&lt;br&gt;per-level prompt,&lt;br&gt;validate + retry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="640" y="240" width="130" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="4. Write Markdown&lt;br&gt;commit + push" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="470" y="350" width="150" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="5. Send email&lt;br&gt;HTML + plain text" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="640" y="350" width="130" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s6" value="On any failure:&lt;br&gt;alert email" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="320" y="350" width="130" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#333333;" edge="1" parent="1" source="s1" target="s2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e23" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#333333;" edge="1" parent="1" source="s2" target="s3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e34" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s3" target="s4">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="705" y="335" />
              <mxPoint x="582" y="335" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e45" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#333333;" edge="1" parent="1" source="s4" target="s5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Scheduler to pipeline -->
        <mxCell id="eTrig" value="triggers" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#6c8ebf;fontSize=11;" edge="1" parent="1" source="sched" target="pipe">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Sources to collect -->
        <mxCell id="eSrc" value="daily only: fetch" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#d6b656;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="srcBox" target="s2">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="507" y="325" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- External services -->
        <mxCell id="claude" value="Anthropic API&lt;br&gt;Claude (model per level)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="980" y="245" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="smtp" value="Gmail SMTP&lt;br&gt;(aggregator account)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="980" y="355" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="inbox" value="Owner inbox&lt;br&gt;marcus_szymanski@epam.com" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="980" y="465" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="eClaude" value="prompt / digest" style="edgeStyle=orthogonalEdgeStyle;html=1;startArrow=classic;endArrow=classic;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="s3" target="claude">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eSmtp" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#333333;" edge="1" parent="1" source="s5" target="smtp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eInbox" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#333333;" edge="1" parent="1" source="smtp" target="inbox">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Repo -->
        <mxCell id="repo" value="Git repo = source of truth (reads config, prompts, lower-level digests; writes digests and state)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=12;fillColor=#f7f2fa;strokeColor=#9673a6;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="520" width="620" height="170" as="geometry" />
        </mxCell>
        <mxCell id="r1" value="&lt;b&gt;config/&lt;/b&gt;&lt;br&gt;sources.yaml&lt;br&gt;settings.yaml" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="312" y="575" width="135" height="95" as="geometry" />
        </mxCell>
        <mxCell id="r2" value="&lt;b&gt;prompts/&lt;/b&gt;&lt;br&gt;daily.md, weekly.md&lt;br&gt;monthly.md, yearly.md" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="462" y="575" width="135" height="95" as="geometry" />
        </mxCell>
        <mxCell id="r3" value="&lt;b&gt;digests/&lt;/b&gt;&lt;br&gt;daily/ weekly/&lt;br&gt;monthly/ yearly/&lt;br&gt;(Markdown)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="612" y="575" width="135" height="95" as="geometry" />
        </mxCell>
        <mxCell id="r4" value="&lt;b&gt;state/&lt;/b&gt;&lt;br&gt;seen.json&lt;br&gt;source-health.json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="762" y="575" width="135" height="95" as="geometry" />
        </mxCell>
        <mxCell id="eCommit" value="commit + push digests/, state/" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#9673a6;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="s4" target="repo">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="545" y="490" />
              <mxPoint x="545" y="490" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Device -->
        <mxCell id="device" value="Owner device&lt;br&gt;local clone (Markdown files)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="980" y="575" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ePull" value="git pull" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#9673a6;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="repo" target="device">
          <mxGeometry relative="1" as="geometry" />
